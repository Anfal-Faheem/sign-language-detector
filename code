import cv2
import mediapipe as mp
import numpy as np
from tensorflow.keras.models import load_model

model = load_model('../../asl_model.h5')

mp_hands = mp.solutions.hands
hands = mp_hands.Hands()
mp_drawing = mp.solutions.drawing_utils

cap = cv2.VideoCapture(0)

while cap.isOpened():
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.flip(frame, 1)
    frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    results = hands.process(frame_rgb)

    if results.multi_hand_landmarks:
        for hand_landmarks in results.multi_hand_landmarks:
            mp_drawing.draw_landmarks(frame, hand_landmarks, mp_hands.HAND_CONNECTIONS)
            
            # Extract 21 (x, y) coordinates and flatten to 42 features
            hand_features = np.array([[landmark.x, landmark.y] for landmark in hand_landmarks.landmark]).flatten()
            hand_features = hand_features.reshape(1, 42)  # shape (1, 42) for model

            prediction = model.predict(hand_features)

            predicted_label = chr(np.argmax(prediction) + ord('A'))
            #cv2.putText(frame, predicted_label, (x_min, y_min - 10), cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 0, 0), 2, cv2.LINE_AA)

            # Use the first landmark (wrist) as the text position
            text_x = int(hand_landmarks.landmark[0].x * frame.shape[1])
            text_y = int(hand_landmarks.landmark[0].y * frame.shape[0]) - 10

            cv2.putText(frame, predicted_label, (text_x, text_y),
            cv2.FONT_HERSHEY_SIMPLEX, 1, (255, 0, 0), 2, cv2.LINE_AA)

    cv2.imshow('ASL Recognition', frame)
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()
